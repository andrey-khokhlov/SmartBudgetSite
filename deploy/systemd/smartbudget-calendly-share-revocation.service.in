[Unit]
Description=SmartBudgetSite Calendly Share Revocation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@JOB_USER@
WorkingDirectory=@JOB_WORKING_DIRECTORY@
ExecStart=@PYTHON_COMMAND@ -m scripts.revoke_calendly_shares
TimeoutStartSec=180s
TimeoutStopSec=15s
Restart=no
RemainAfterExit=no
StandardOutput=journal
StandardError=journal
