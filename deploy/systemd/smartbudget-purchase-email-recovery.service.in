[Unit]
Description=SmartBudgetSite Purchase Email Recovery
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@JOB_USER@
WorkingDirectory=@JOB_WORKING_DIRECTORY@
ExecStart=@PYTHON_COMMAND@ -m scripts.recover_purchase_emails
TimeoutStartSec=300s
TimeoutStopSec=15s
Restart=no
RemainAfterExit=no
StandardOutput=journal
StandardError=journal
