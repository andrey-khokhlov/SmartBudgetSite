# Compose inputs. Copy to a private file and fill in deployment values.
SMARTBUDGET_HOST=smartbudget.example.invalid
# Set one operator VPN IPv4 /32 in the private Compose file before starting Caddy.
SMARTBUDGET_ALLOWED_IP=
SMARTBUDGET_APP_ENV_FILE=.env.production.app.local
POSTGRES_USER=smartbudget_bootstrap
POSTGRES_PASSWORD=
POSTGRES_DB=smartbudget
